# Do NOT read, index, or reference these files unless explicitly requested by the user.
# This protects the context window from large, generated, or binary content.
# Uses .gitignore syntax; patterns are relative to the workspace root.
# Mirrors .claudeignore. Entries Kilo already skips by default (node_modules/, .git/,
# dist/, build/, lock files) are omitted.

# Large data asset — import via src/db/database.ts, never inline
src/assets/dictionary.json

# Generated native folders (Continuous Native Generation) — configure in app.json
/ios/
/android/
.kotlin/

# Expo / Metro caches and generated types
.expo/
.expo-shared/
web-build/
expo-env.d.ts

# Generated / vendored output
repomix-output.xml

# Image and font binaries
assets/**/*.png
assets/**/*.jpg
assets/**/*.jpeg
assets/**/*.gif
assets/**/*.ttf
assets/**/*.otf

# Signing material and secrets
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env
.env*.local

# CI config
.github/

# Agent scratch space
.kilo/
.claude/settings.local.json